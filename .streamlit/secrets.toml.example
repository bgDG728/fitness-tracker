# 複製這個檔案成 .streamlit/secrets.toml(該檔名已在 .gitignore,不會進 git),
# 填入 Turso 資料庫的連線資訊,本機就會跟雲端版共用同一份資料。
# 沒有這個檔案 / 沒設定這兩個值時,db.py 會自動退回純本機 sqlite3。
#
# 部署到 Streamlit Community Cloud 時,同樣的兩個值要貼到
# share.streamlit.io 該 app 的 Settings → Secrets,格式一樣是 TOML。

TURSO_DATABASE_URL = "libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN = "your-auth-token"
